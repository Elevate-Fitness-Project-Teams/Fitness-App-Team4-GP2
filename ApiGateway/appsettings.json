{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "api/v1/auth/{**catch-all}"
        }
      },
      "fitness-route": {
        "ClusterId": "fce-cluster",
        "Match": {
          "Path": "api/v1/fitness/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "api/v1/notifications/{**catch-all}"
        }
      },
      "nutrition-route": {
        "ClusterId": "nutrition-cluster",
        "Match": {
          "Path": "api/v1/nutrition/{**catch-all}"
        }
      },
      "profile-route": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "api/v1/profile/{**catch-all}"
        }
      },
      "progress-route": {
        "ClusterId": "progress-cluster",
        "Match": {
          "Path": "api/v1/progress/{**catch-all}"
        }
      },
      "smartcoach-route": {
        "ClusterId": "smartcoach-cluster",
        "Match": {
          "Path": "api/v1/smart-coach/{**catch-all}"
        }
      },
      "subscription-route": {
        "ClusterId": "subscription-cluster",
        "Match": {
          "Path": "api/v1/subscription/{**catch-all}"
        }
      },
      "workouts-route": {
        "ClusterId": "workout-cluster",
        "Match": {
          "Path": "api/v1/workouts/{**catch-all}"
        }
      },
      "exercises-route": {
        "ClusterId": "workout-cluster",
        "Match": {
          "Path": "api/v1/exercises/{**catch-all}"
        }
      },
      "workout-plans-route": {
        "ClusterId": "workout-cluster",
        "Match": {
          "Path": "api/v1/workout-plans/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://authservice:8080"
          }
        }
      },
      "fce-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://fceservice:8080"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://notificationservice:8080"
          }
        }
      },
      "nutrition-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://nutritionservice:8080"
          }
        }
      },
      "profile-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://profileservice:8080"
          }
        }
      },
      "progress-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://progressservice:8080"
          }
        }
      },
      "smartcoach-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://smartcoachservice:8080"
          }
        }
      },
      "subscription-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://subscriptionservice:8080"
          }
        }
      },
      "workout-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://workoutservice:8080"
          }
        }
      }
    }
  }
}

